# Copy to repo root as `.env` on the VPS.
# Never commit real `.env`.
#
# Full Docker reference: docker/README.md
# VPS deploy start-to-finish: docs/vps-deployment.md
#
# Production layout for Kraftisium:
#   https://kraftisium.xyz        → web SPA (host nginx → 172.28.0.21)
#   https://api.kraftisium.xyz    → merged BFF (host nginx → 172.28.0.20)
#
# Deploy on 45.154.197.90:
#   ./scripts/vps-deploy-production.sh
#   sudo ./scripts/vps-fix-host-nginx.sh   # first time TLS
#   sudo ./scripts/vps-fix-ssl-lineage.sh  # if api SSL fails after certbot
#
# Alternate (other hosts, compose owns 80/443):
#   ./scripts/vps-deploy.sh  (requires system nginx stopped)

POSTGRES_PASSWORD=change_me_strong
JWT_SECRET=change_me_long_random

# Resend (auth + founding premium emails). Can also set in bff/.env.
# BFF__EMAIL__API_KEY=re_...
# BFF__EMAIL__FROM_EMAIL=noreply@kraftisium.xyz

# Browser / client URLs
PUBLIC_WEB_URL=https://kraftisium.xyz
PUBLIC_BFF_URL=https://api.kraftisium.xyz

# Edge nginx + certbot (subdomain split — NGINX_SAME_ORIGIN=0)
WEB_HOST=kraftisium.xyz
API_HOST=api.kraftisium.xyz
CERT_PRIMARY_DOMAIN=kraftisium.xyz
NGINX_SAME_ORIGIN=0

CERTBOT_EMAIL=you@example.com

# Same-origin alternative (SPA + /api/v1 on one host — simpler, no CORS):
# PUBLIC_WEB_URL=https://kraftisium.xyz
# PUBLIC_BFF_URL=__RELATIVE__
# WEB_HOST=kraftisium.xyz
# API_HOST=kraftisium.xyz
# CERT_PRIMARY_DOMAIN=kraftisium.xyz
# NGINX_SAME_ORIGIN=1

# Yearly Premium — grant via payment or promo codes at checkout
# BFF__SUBSCRIPTION__FOUNDING_PREMIUM_LIMIT=0
# BFF__SUBSCRIPTION__FOUNDING_PREMIUM_YEARS=1
# BFF__SUBSCRIPTION__YEARLY_PRICE_USD=199
# BFF__SUBSCRIPTION__FREE_AI_MATCHES_LIMIT=3

# Hybrid AI matcher (MiniLM embeddings). Required for real AI Matches.
COMPOSE_ML=1
# With compose.vps-fix.yml use the static IP — Docker DNS is broken on that host.
BFF__MATCHER__BASE_URL=http://172.28.0.22:8095
BFF__MATCHER__INTERNAL_SECRET=
MATCHER_INTERNAL_SECRET=
MATCHER_PREFILTER_LIMIT=200
MATCHER_PREFILTER_DAYS=365
MATCHER_TOP_K=25
MATCHER_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
MATCHER_DEVICE=cpu

# Cloudflare Turnstile (public site key baked into the web image)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFBOT8vJ2RagpNqk
# Secret + hostnames can live in root .env (compose injects them) or bff/.env
# BFF__TURNSTILE__SECRET_KEY=
# BFF__TURNSTILE__HOSTNAMES=kraftisium.xyz

# Host nginx loopback port overrides (compose.host-edge.yml)
# WEB_HOST_EDGE_PORT=14680
# BFF_HOST_EDGE_PORT=14682
# MATCHER_HOST_EDGE_PORT=14685

# Local dev port overrides (compose.dev.yml)
# WEB_HOST_PORT=80
# BFF_HOST_PORT=8000
# RUSTFS_API_PORT=9000
# RUSTFS_CONSOLE_PORT=9001
# MATCHER_HOST_PORT=8095

# Mobile app production builds (EAS) — must match PUBLIC_BFF_URL
# EXPO_PUBLIC_BFF_API_URL=https://api.kraftisium.xyz

# Google OAuth (BFF handles full flow; register redirect URI in Google Cloud Console)
# BFF__OAUTH__GOOGLE__CLIENT_ID=your-client-id.apps.googleusercontent.com
# BFF__OAUTH__GOOGLE__CLIENT_SECRET=your-client-secret
# BFF__OAUTH__GOOGLE__REDIRECT_URI=https://api.kraftisium.xyz/api/v1/auth/google/callback

# Off-VPS backups (Postgres + RustFS resumes -> S3-compatible target).
# Required for the `backup` service in compose.prod.yml. See docker/backup/README.md.
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=kraftisium-backups
BACKUP_S3_ACCESS_KEY_ID=change_me
BACKUP_S3_SECRET_ACCESS_KEY=change_me
# BACKUP_S3_PROVIDER=Cloudflare
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14
