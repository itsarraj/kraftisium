# Host nginx — kraftisium.xyz (SPA) + api.kraftisium.xyz (merged BFF)
# Expects compose.host-edge.yml + compose.vps-fix.yml static IPs (or loopback 14680/14682):
#   kraftisium-web: 172.28.0.21:80
#   bff:               172.28.0.20:8000
#
# Install: sudo cp this file /etc/nginx/conf.d/kraftisium.conf
#          sudo ./scripts/vps-fix-ssl-lineage.sh
#
# TLS: certbot may save under kraftisium.xyz-0001 (not kraftisium.xyz).
# vps-fix-ssl-lineage.sh updates ssl_certificate paths automatically.

server {
    listen 80;
    server_name kraftisium.xyz www.kraftisium.xyz api.kraftisium.xyz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.kraftisium.xyz;
    client_max_body_size 64m;

    ssl_certificate     /etc/letsencrypt/live/kraftisium.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kraftisium.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=63072000" always;

    location / {
        proxy_pass http://172.28.0.20:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name kraftisium.xyz www.kraftisium.xyz;
    client_max_body_size 64m;

    ssl_certificate     /etc/letsencrypt/live/kraftisium.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kraftisium.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=63072000" always;

    location / {
        proxy_pass http://172.28.0.21:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
