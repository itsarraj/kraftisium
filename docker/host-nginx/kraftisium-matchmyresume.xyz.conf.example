#
# kraftisium.xyz -> loopback (host nginx, same-origin).
#
# Expects compose.host-edge.yml:
#   kraftisium-web:  127.0.0.1:14680
#   bff:               127.0.0.1:14682
#
# Routing:
#   /api/v1/*  -> bff (auth, jobs, resumes, subscriptions, suggested jobs, uploads)
#   /*         -> kraftisium-web (SPA: /upgrade, /checkout, /ai-matches, …)
#

server {
    listen 80;
    server_name kraftisium.xyz www.kraftisium.xyz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name kraftisium.xyz www.kraftisium.xyz;
    client_max_body_size 64m;

    ssl_certificate     /etc/letsencrypt/live/kraftisium.xyz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kraftisium.xyz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=63072000" always;

    location ^~ /api/v1/ {
        proxy_pass http://127.0.0.1:14682;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:14680;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
