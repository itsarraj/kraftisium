# Merged BFF (auth + jobs + resumes + subscriptions)
VITE_BFF_API_URL=http://localhost:8000
VITE_BFF_API_VERSION=v1
# Production: https://api.kraftisium.xyz

# Application
VITE_APP_NAME=Kraftisium
VITE_APP_URL=http://localhost:5173
# Production: https://kraftisium.xyz

# Token storage keys
VITE_ACCESS_TOKEN_KEY=kraftisium_access_token
VITE_REFRESH_TOKEN_KEY=kraftisium_refresh_token
VITE_USER_PROFILE_KEY=kraftisium_user_profile

# Google sign-in is handled by the BFF (no client-side Google SDK required).
# Configure BFF__OAUTH__GOOGLE__* on the backend; VITE_APP_URL must match your web origin for OAuth callback.

# Razorpay Standard Checkout (optional fallback — checkout uses key_id from BFF create-order response)
# Must match BFF__RAZORPAY__KEY_ID if set. Prefer test keys (rzp_test_*) for local dev.
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Cloudflare Turnstile CAPTCHA (register/login). Public site key -- safe to
# expose in frontend bundles. Unset = Cloudflare's official always-passes
# test key, so local dev works without a Cloudflare account. Must match
# BFF__TURNSTILE__SECRET_KEY on the backend, or the widget will render but
# the backend will reject every token. See docs/turnstile.md.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
