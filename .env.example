# Kraftisium Root Environment Variables Example
# Copy to .env for local development or docker compose

DATABASE_URL=postgres://seekers:your_postgres_password@localhost:5432/kraftisium

POSTGRES_PASSWORD=your_local_postgres_password
JWT_SECRET=your_local_jwt_secret_min_32_chars

PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_BFF_URL=http://localhost:8000

# S3 / Object Storage backup credentials
BACKUP_S3_ENDPOINT=http://127.0.0.1:9000
BACKUP_S3_BUCKET=kraftisium-backup
BACKUP_S3_ACCESS_KEY_ID=rustfsadmin
BACKUP_S3_SECRET_ACCESS_KEY=rustfsadmin
