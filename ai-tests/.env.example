# Copy to ai-tests/.env (or export before running matcher_service).
# Same PostgreSQL database as the BFF (kraftisium).

export DATABASE_URL=postgres://cesium@127.0.0.1:5432/kraftisium
export MATCHER_BFF_URL=http://127.0.0.1:8000
export MATCHER_DEVICE=cpu
export MATCHER_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# Optional
# export MATCHER_INTERNAL_SECRET=
# export MATCHER_PREFILTER_LIMIT=200
# export MATCHER_TOP_K=25
