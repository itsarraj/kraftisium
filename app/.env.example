# Copy to .env (create next to package.json). Expo reads EXPO_PUBLIC_* at bundle time — restart Metro after edits.
# Guides: ../docs/mobile-android-local-build.md (local) | mobile-android-build.md (EAS)

# --- Default: production API (phone / preview / store builds) ---
EXPO_PUBLIC_BFF_API_URL=https://api.kraftisium.xyz
EXPO_PUBLIC_BFF_API_VERSION=v1

# --- Local BFF on your PC (optional) — uncomment block below ---
# EXPO_PUBLIC_USE_LOCAL_BFF=1
# EXPO_PUBLIC_BFF_API_URL=http://localhost:8000
# EXPO_PUBLIC_DEV_TRANSPORT=adb
# npm run dev:android-tunnel-adb

# --- Wi-Fi LAN local BFF ---
# EXPO_PUBLIC_USE_LOCAL_BFF=1
# EXPO_PUBLIC_BFF_API_URL=http://localhost:8000
# EXPO_PUBLIC_DEV_API_HOST=192.168.1.50

# Android emulator:
# EXPO_PUBLIC_ANDROID_EMULATOR_HOST=10.0.2.2

# Google sign-in: BFF handles OAuth. Set BFF__OAUTH__GOOGLE__* on the API server.
# Mobile opens /api/v1/auth/google and returns via kraftisium://auth/google/callback

# --- OTA updates (optional) --- leave unset to skip HotUpdater.wrap() entirely.
# Fill in once the Cloudflare Worker from hot-updater.config.ts is deployed (see .env.hotupdater.example).
# EXPO_PUBLIC_HOT_UPDATER_BASE_URL=https://<your-worker>.workers.dev/api/check-update
