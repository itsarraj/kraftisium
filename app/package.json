{
  "name": "kraftisium",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "start:clear": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo prebuild && expo run:android",
    "android:device": "expo run:android --device",
    "android:devices": "adb devices",
    "android:reverse": "adb reverse tcp:8081 tcp:8081",
    "android:reverse:all": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:19000 tcp:19000 && adb reverse tcp:19001 tcp:19001 && adb reverse tcp:19002 tcp:19002",
    "android:reverse:dev": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8000 tcp:8000",
    "dev:android-adb": "bun run android:reverse:dev && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 EXPO_PUBLIC_DEV_TRANSPORT=adb expo start --dev-client",
    "dev:android-adb:clear": "bun run android:reverse:dev && REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 EXPO_PUBLIC_DEV_TRANSPORT=adb expo start --dev-client --clear",
    "dev:android-tunnel-adb": "bun run android:reverse:dev && EXPO_PUBLIC_DEV_TRANSPORT=adb expo start --dev-client --tunnel",
    "dev:android-tunnel-ad": "bun run dev:android-tunnel-adb",
    "dev:phone:production-api": "EXPO_PUBLIC_BFF_API_URL=https://api.kraftisium.xyz EXPO_PUBLIC_BFF_API_VERSION=v1 expo start --dev-client --clear",
    "dev:phone:production-api:lan": "EXPO_PUBLIC_BFF_API_URL=https://api.kraftisium.xyz EXPO_PUBLIC_BFF_API_VERSION=v1 expo start --dev-client --lan --clear",
    "android:device:production-api": "EXPO_PUBLIC_BFF_API_URL=https://api.kraftisium.xyz EXPO_PUBLIC_BFF_API_VERSION=v1 expo run:android --device",
    "android:open": "bun run android:reverse:dev && adb shell am start -a android.intent.action.VIEW -d 'exp+kraftisium://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081'",
    "android:clean": "cd android && ./gradlew clean",
    "android:install:adb": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:android --device --no-bundler",
    "android:rebuild": "bun run android:clean && expo run:android --device",
    "android:release": "cd android && ./gradlew :app:assembleRelease",
    "android:bundle": "cd android && ./gradlew :app:bundleRelease",
    "android:logcat": "adb logcat *:S ReactNative:V ReactNativeJS:V Expo:V",
    "keystore": "bash scripts/make-keystore.sh",
    "check": "npx expo install --check",
    "doctor": "npx expo-doctor@latest",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean",
    "run:android": "npx expo run:android",
    "run:ios": "npx expo run:ios",
    "ios": "npx expo prebuild && npm run fix-xcode-env && expo run:ios",
    "fix-xcode-env": "node scripts/fix-xcode-env.mjs",
    "web": "expo start --web",
    "lint": "expo lint",
    "generate-icons": "bash ./scripts/generate-app-icons.sh",
    "eas:android:preview": "eas build -p android --profile preview",
    "eas:android:production": "eas build -p android --profile production",
    "eas:submit:android": "eas submit -p android --profile production",
    "ota-android": "npx hot-updater deploy -p android",
    "ota-ios": "npx hot-updater deploy -p ios",
    "ota-console": "npx hot-updater console"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hot-updater/expo": "^0.36.15",
    "@hot-updater/react-native": "^0.36.15",
    "@legendapp/list": "^3.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.103.2",
    "expo": "~56.0.22",
    "expo-auth-session": "~56.0.19",
    "expo-build-properties": "~56.0.27",
    "expo-constants": "~56.0.26",
    "expo-dev-client": "~56.0.27",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.13",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.18",
    "expo-router": "~56.2.21",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-splash-screen": "~56.0.15",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.7",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@hot-updater/cloudflare": "^0.36.15",
    "@react-native-community/cli": "latest",
    "@types/react": "~19.2.2",
    "dotenv": "^16.4.5",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "hot-updater": "^0.36.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
