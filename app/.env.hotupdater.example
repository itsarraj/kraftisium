# Copy to .env.hotupdater (next to hot-updater.config.ts). Used by `npm run ota-*` / `hot-updater console`,
# NOT read by the Expo app bundle. Provision these by running `npx hot-updater init` with a Cloudflare
# account logged into wrangler, or create the R2 bucket + D1 database + Worker by hand — see
# https://gronxb.github.io/hot-updater/guide/get-started/quick-start-cloudflare.html
HOT_UPDATER_CLOUDFLARE_ACCOUNT_ID=
HOT_UPDATER_CLOUDFLARE_API_TOKEN=
HOT_UPDATER_CLOUDFLARE_R2_BUCKET_NAME=
HOT_UPDATER_CLOUDFLARE_D1_DATABASE_ID=

# After the Worker is deployed, put its check-update URL in the app's own .env as
# EXPO_PUBLIC_HOT_UPDATER_BASE_URL=https://<your-worker>.workers.dev/api/check-update
