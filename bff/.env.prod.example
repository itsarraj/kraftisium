# Kraftisium BFF — Production secrets template
# Location on VPS: ~/kraftisium/bff/.env.prod
# Permissions: chmod 600
# NEVER commit the real secrets file.

POSTGRES_USER=seekers
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=kraftisium
DATABASE_URL=postgres://seekers:your_secure_postgres_password@localhost:5432/kraftisium

# Generated via: openssl rand -hex 32
BFF__JWT__SECRET=your_production_jwt_secret_hex_32
BFF__JWT__ACCESS_TOKEN_EXPIRATION_HOURS=24
BFF__JWT__REFRESH_TOKEN_EXPIRATION_DAYS=30

BFF__APPLICATION_PORT=8000
BFF__APPLICATION_HOST=0.0.0.0

# URLs
BFF__EMAIL__BASE_URL=https://api.kraftisium.xyz
BFF__EMAIL__FRONTEND_BASE_URL=https://kraftisium.xyz
BFF__EMAIL__FROM_EMAIL=hello@kraftisium.xyz
BFF__EMAIL__FROM_NAME=Kraftisium

# Email (Resend)
BFF__EMAIL__API_KEY=re_your_production_resend_api_key

# Object Storage
BFF__OBJECT_STORAGE__ENDPOINT=https://storage.kraftisium.xyz
BFF__OBJECT_STORAGE__BUCKET=resumes
BFF__OBJECT_STORAGE__ACCESS_KEY_ID=your_access_key
BFF__OBJECT_STORAGE__SECRET_ACCESS_KEY=your_secret_key
BFF__OBJECT_STORAGE__REGION=us-east-1

# Google OAuth
BFF__OAUTH__GOOGLE__CLIENT_ID=your-google-client-id.apps.googleusercontent.com
BFF__OAUTH__GOOGLE__CLIENT_SECRET=GOCSPX-your-google-client-secret
BFF__OAUTH__GOOGLE__REDIRECT_URI=https://api.kraftisium.xyz/api/v1/auth/google/callback

# Razorpay (Credentials)
BFF__RAZORPAY__KEY_ID=rzp_test_your_key_id
BFF__RAZORPAY__KEY_SECRET=your_razorpay_secret
BFF__RAZORPAY__WEBHOOK_SECRET=your_webhook_secret
BFF__RAZORPAY__CURRENCY=USD
BFF__RAZORPAY__YEARLY_AMOUNT_PAISE=19900

# Cloudflare Turnstile
BFF__TURNSTILE__SECRET_KEY=0x4AAAAAA_your_secret_key
BFF__TURNSTILE__HOSTNAMES=kraftisium.xyz
