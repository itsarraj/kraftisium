# This file is used to set environment variables for the merged BFF backend.
# configurations.rs reads these variables and uses them to configure the application.
# configuration.yaml provides default values; override secrets here or in your environment.

# for sqlx migrations
DATABASE_URL=postgres://cesium@localhost/kraftisium

# for the application
BFF__APPLICATION_PORT=8000
BFF__APPLICATION_HOST=127.0.0.1

BFF__DATABASE__HOST=127.0.0.1
BFF__DATABASE__PORT=5432
BFF__DATABASE__USERNAME=cesium
BFF__DATABASE__PASSWORD=""
BFF__DATABASE__DATABASE_NAME=kraftisium

BFF__REDIS__HOST=127.0.0.1
BFF__REDIS__PORT=6379
BFF__REDIS__PASSWORD=
BFF__REDIS__DATABASE=

BFF__JWT__SECRET=your-super-secret-jwt-key-change-this-in-production
BFF__JWT__ACCESS_TOKEN_EXPIRATION_HOURS=24
BFF__JWT__REFRESH_TOKEN_EXPIRATION_DAYS=30

# Homepage stats widget. use_hardcoded=true (default): /stats reads the 4
# numbers below straight from config, no DB access at all. Set to false to
# instead recompute real numbers from the DB every refresh_interval_seconds
# and serve those (candidates = resumes uploaded in that mode).
BFF__STATS__USE_HARDCODED=true
BFF__STATS__REFRESH_INTERVAL_SECONDS=3600
BFF__STATS__LIVE_JOBS=764
BFF__STATS__COMPANIES=500
BFF__STATS__CANDIDATES=52417
BFF__STATS__NEW_JOBS=516

BFF__OBJECT_STORAGE__ENDPOINT=http://127.0.0.1:9000
BFF__OBJECT_STORAGE__BUCKET=resumes
BFF__OBJECT_STORAGE__ACCESS_KEY_ID=rustfsadmin
BFF__OBJECT_STORAGE__SECRET_ACCESS_KEY=rustfsadmin
BFF__OBJECT_STORAGE__REGION=us-east-1

# Email (Resend) — never commit real API keys
# BFF__EMAIL__API_KEY=re_xxxxxxxx
BFF__EMAIL__FROM_EMAIL="noreply@resend.dev"
BFF__EMAIL__FROM_NAME="Kraftisium"
BFF__EMAIL__BASE_URL="http://localhost:8000"
BFF__EMAIL__FRONTEND_BASE_URL="http://localhost:5173"
# Production:
# BFF__EMAIL__FRONTEND_BASE_URL=https://kraftisium.xyz
# BFF__EMAIL__BASE_URL=https://api.kraftisium.xyz

# Hybrid AI matcher (optional — see ai-tests/README-matcher.md)
BFF__MATCHER__BASE_URL=http://127.0.0.1:8095
# BFF__MATCHER__INTERNAL_SECRET=

# Yearly Premium — grant via payment or promo codes (see SQL example below).
# BFF__SUBSCRIPTION__FOUNDING_PREMIUM_LIMIT=0
BFF__SUBSCRIPTION__FOUNDING_PREMIUM_YEARS=1
BFF__SUBSCRIPTION__YEARLY_PRICE_USD=199
BFF__SUBSCRIPTION__FREE_AI_MATCHES_LIMIT=3
# BFF__SUBSCRIPTION__AUTO_GRANT_YEARLY_PREMIUM=true
#
# Create promo codes in Postgres (100% discount = free Premium at checkout):
# INSERT INTO promo_codes (code, discount_percentage, duration_months, max_uses)
# VALUES ('YOURCODE', 100, 12, 1);
#
# Share with recipients: https://kraftisium.xyz/redeem?promo=YOURCODE

# Google OAuth — register redirect URIs in Google Cloud Console
# Local:  http://localhost:8000/api/v1/auth/google/callback
# Prod:   https://api.kraftisium.xyz/api/v1/auth/google/callback
# Mobile deep link (Expo): kraftisium://auth/google/callback
# BFF__OAUTH__GOOGLE__CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# BFF__OAUTH__GOOGLE__CLIENT_SECRET=your-google-client-secret
# BFF__OAUTH__GOOGLE__REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Razorpay Standard Checkout — KEY_SECRET must stay on the server only
# Generate at https://dashboard.razorpay.com/app/keys (test keys for local dev)
# BFF__RAZORPAY__KEY_ID=rzp_test_xxxxxxxx
# BFF__RAZORPAY__KEY_SECRET=your_razorpay_key_secret
# BFF__RAZORPAY__WEBHOOK_SECRET=your_webhook_secret
# Webhook URL (prod): https://api.kraftisium.xyz/api/v1/payments/webhook
# Event: payment.captured
BFF__RAZORPAY__CURRENCY=USD
BFF__RAZORPAY__YEARLY_AMOUNT_PAISE=19900

# Cloudflare Turnstile CAPTCHA on register/login. Unset (default) = feature
# off entirely -- no token required, existing behavior unchanged. Setting
# this ALSO blocks the mobile app's register/login (it has no Turnstile
# widget) unless a bypass is added first. See docs/turnstile.md before
# enabling this anywhere the mobile app also talks to.
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Test secret (pairs with the UI's default test site key, always passes):
# BFF__TURNSTILE__SECRET_KEY=1x0000000000000000000000000000000AA
# Frontend hostnames siteverify must return. Required when the secret is set.
# Local only. Production (kraftisium.xyz) must not include localhost.
# BFF__TURNSTILE__HOSTNAMES=localhost,127.0.0.1
